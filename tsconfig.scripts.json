{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/test/snapshot-privacy.test.ts",
    "scripts/**/*.mjs"
  ]
}
